{
  "name": "terabox-telegram-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file .env server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "telegram": "^2.26.22",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
